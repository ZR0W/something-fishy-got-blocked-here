{
  "manifest_version": 3,
  "name": "Something Fishy",
  "version": "0.1.0",
  "description": "When your DNS (e.g. Pi-hole) blocks a site, shows your own message instead of Firefox's error page.",
  "browser_specific_settings": {
    "gecko": {
      "id": "somethingfishy@sf.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["dns", "webNavigation", "tabs", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": [
      "src/common/address.js",
      "src/common/url.js",
      "src/common/config.js",
      "src/common/attempts.js",
      "src/common/decide.js",
      "src/background/background.js"
    ]
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  }
}
